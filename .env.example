# ═══════════════════════════════════════════════════════
#  AfricaWatch — Variables d'environnement
#  Copier en .env et adapter les valeurs
#  NE JAMAIS committer .env dans Git
# ═══════════════════════════════════════════════════════

# ─── DJANGO ──────────────────────────────────────────
DJANGO_SETTINGS_MODULE=africanwatch.settings.dev
SECRET_KEY=changez-moi-minimum-64-caracteres-obligatoire-en-production
DEBUG=True

# Mode labo : autorise les cibles privées UNIQUEMENT pour un environnement isolé
LAB_MODE=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── BASE DE DONNÉES ─────────────────────────────────
POSTGRES_DB=africanwatch
POSTGRES_USER=aw_user
POSTGRES_PASSWORD=changeme_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── REDIS ───────────────────────────────────────────
CELERY_CONCURRENCY=2
REDIS_PASSWORD=redis_changeme
REDIS_URL=redis://:redis_changeme@redis:6379/0

# ─── ELASTICSEARCH ───────────────────────────────────
# Laisser vide en mode LITE
ELASTICSEARCH_URL=

# ─── KAFKA ───────────────────────────────────────────
# Laisser vide en mode LITE
KAFKA_BOOTSTRAP_SERVERS=

# ─── MONITORING ──────────────────────────────────────
GRAFANA_PASSWORD=grafana_changeme

# ─── SUPERUSER INITIAL ───────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@example.invalid
DJANGO_SUPERUSER_PASSWORD=GENERATE_A_UNIQUE_32_CHAR_PASSWORD

# ─── FRONTEND ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── CORS ────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── LLM LOCAL (souveraineté des données) ────────────
OLLAMA_URL=http://ollama:11434
AI_ENABLED=False
AI_MODEL=qwen2.5:1.5b-instruct-q3_K_S
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=384
AI_TIMEOUT_SECONDS=15
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q3_K_S

# ─── INTÉGRATIONS (optionnelles) ─────────────────────
# VirusTotal (500 req/jour gratuit): https://virustotal.com
VIRUSTOTAL_API_KEY=

# Shodan (gratuit limité): https://account.shodan.io
SHODAN_API_KEY=

# AlienVault OTX (gratuit): https://otx.alienvault.com
OTX_API_KEY=

# MISP (si instance propre)
MISP_URL=
MISP_KEY=

# GeoIP MaxMind (gratuit sur inscription): https://maxmind.com
GEOIP_PATH=/app/data/geoip
MAXMIND_LICENSE_KEY=

# Africa's Talking SMS (sandbox gratuit): https://africastalking.com
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox

# Offensive assessment controls
SECURITY_ASSESSMENT_KILL_SWITCH=False
SECURITY_ASSESSMENT_CONCURRENCY_RETRY_SECONDS=5
# Ports HTTP publics autorisés pour les contrôles Web hors LAB
ALLOWED_PUBLIC_TARGET_PORTS=80,443,8080,8443

# Security Lab — local analysis roots; mount these read-only into the worker.
SECURITY_CODE_ROOT=/security-lab/code
SECURITY_CONTAINER_ROOT=/security-lab/containers
CREDENTIAL_LAB_ROOT=/security-lab/credentials
CREDENTIAL_WORDLIST_ROOT=/security-lab/wordlists
ALLOW_LOCAL_CREDENTIAL_AUDIT=false
SECURITY_LAB_MAX_RUNTIME=300
# DB audit profiles are tenant-scoped: SECURITY_DB_DSN_<ORG_UUID_NO_DASH>_<PROFILE>
# Example: SECURITY_DB_DSN_0123456789ABCDEF0123456789ABCDEF_PROD=postgresql://...

# ─── INTELLIGENCE CENTER ─────────────────────────────
# Tor est réservé à la collecte passive de sources explicitement autorisées.
TOR_ENABLED=False
TOR_SOCKS_PROXY=socks5://tor:9050
# Tor is limited to passive Onion intelligence; never used to hide active scans.
TOR_PASSIVE_ONLY=True
# Liste d'hôtes .onion autorisés, séparés par des virgules. Laisser vide par défaut.
ONION_ALLOWED_HOSTS=
INTEL_MAX_SOURCES_PER_RUN=12
INTEL_MAX_OBSERVATIONS_PER_RUN=100
INTEL_ENABLE_GDELT=True
# Heavy NLP and external translation stay off by default for 8GB RAM / data sovereignty.
OSINT_SPACY_ENABLED=False
OSINT_EXTERNAL_TRANSLATION_ENABLED=False

# ─── MALWARE / CODE ANALYSIS ─────────────────────────
MALWARE_MAX_UPLOAD_BYTES=26214400
MALWARE_QUARANTINE_ROOT=/security-lab/quarantine
MALWARE_YARA_RULES=/security-lab/yara/africanwatch.yar
MALWARE_SCANNER_DAEMON_ENABLED=True
MALWARE_SCAN_JOBS_ROOT=/security-lab/jobs
MALWARE_SCAN_RESULTS_ROOT=/security-lab/results
